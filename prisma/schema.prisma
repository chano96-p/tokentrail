generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id       String    @id @default(cuid())
  cwd      String    @unique
  name     String
  sessions Session[]
}

model Session {
  id               String          @id
  projectId        String
  project          Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title            String?
  titleSource      String?
  gitBranch        String?
  cliVersion       String?
  startedAt        DateTime
  endedAt          DateTime
  inputTokens      Int             @default(0)
  outputTokens     Int             @default(0)
  cacheReadTokens  Int             @default(0)
  cacheWriteTokens Int             @default(0)
  totalTokens      Int             @default(0)
  subagentCount    Int             @default(0)
  apiCalls         ApiCall[]
  events           TimelineEvent[]

  @@index([startedAt])
  @@index([totalTokens])
}

model ApiCall {
  sessionId          String
  messageId          String
  session            Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  agentId            String?
  sourceFileId       String
  sourceFile         ImportedFile @relation(fields: [sourceFileId], references: [id], onDelete: Cascade)
  model              String
  timestamp          DateTime
  inputTokens        Int
  outputTokens       Int
  cacheReadTokens    Int
  cacheWrite5mTokens Int
  cacheWrite1hTokens Int
  stopReason         String?
  skill              String?
  plugin             String?

  @@id([sessionId, messageId])
  @@index([timestamp])
  @@index([messageId])
}

model TimelineEvent {
  uuid          String
  sessionId     String
  session       Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  agentId       String?
  parentUuid    String?
  apiCallId     String?
  sourceFileId  String
  sourceFile    ImportedFile @relation(fields: [sourceFileId], references: [id], onDelete: Cascade)
  timestamp     DateTime
  kind          String
  toolName      String?
  inputSummary  String?
  isError       Boolean      @default(false)
  contentLength Int          @default(0)
  preview       String?

  @@id([sessionId, uuid])
  @@index([sessionId, timestamp])
}

model ImportedFile {
  id         String          @id @default(cuid())
  path       String          @unique
  size       Int
  mtimeMs    Float
  byteOffset Int
  importedAt DateTime        @updatedAt
  apiCalls   ApiCall[]
  events     TimelineEvent[]
}
